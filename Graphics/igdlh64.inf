Default = %GUID_TYPICAL_POWER_SAVINGS%, %AC%, 1
Default = %GUID_TYPICAL_POWER_SAVINGS%, %DC%, 1 
Default = %GUID_MIN_POWER_SAVINGS%, %AC%, 2
