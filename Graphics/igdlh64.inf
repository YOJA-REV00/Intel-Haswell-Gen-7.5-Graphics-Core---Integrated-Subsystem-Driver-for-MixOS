igfx.Miniport          = 12  ; drivers
igfx.MiniportLP      = 12  ; drivers
igfx.UserMode       = 11  ; system32
igfx.UMWow          = 10, SysWow64
Installer.Copy       = 11  ; system32

CUI.Copy            = 11  ; system32
